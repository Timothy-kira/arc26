{
 "hooks": {
  "SessionStart": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python3 \"$MINIMAX_PLUGIN_ROOT\"/hooks/arc_hooks.py context"
     }
    ]
   }
  ],
  "PreToolUse": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python3 \"$MINIMAX_PLUGIN_ROOT\"/hooks/arc_hooks.py guard"
     }
    ]
   }
  ],
  "PostToolUse": [
   {
    "hooks": [
     {
      "type": "command",
      "command": "python3 \"$MINIMAX_PLUGIN_ROOT\"/hooks/arc_hooks.py record"
     }
    ]
   }
  ]
 }
}